# ============================================================================
#  NikhilAI — .env.example
#  Copy karo:  cp .env.example .env     (Windows: copy .env.example .env)
#  Sirf ye 3 kaam karo: naam likho, ek brain key daalo, (optional) voice/telegram.
#  Yahan sirf PLACEHOLDERS hain — koi asli key commit mat karo.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) IDENTITY  (kuch bhi code me hardcode nahi hai — sab yahan se)
# ---------------------------------------------------------------------------
NIKHILAI_NAME=NikhilAI
OWNER_NAME=Your Name
OWNER_ID=
OWNER_NAME_HINDI=
CITY=Kota                         # configurable personal default for weather/context
TIMEZONE=Asia/Kolkata             # IANA timezone; invalid value falls back to Asia/Kolkata
ASSISTANT_PERSONALITY=smart,friendly,concise,agentic
LANGUAGE=hinglish                 # hinglish | hindi | english | auto
RESPONSE_STYLE=concise            # concise | detailed | bullet
DEFAULT_MODE=text                 # preferred interface only; does not start mic/LiveKit by itself

# ---------------------------------------------------------------------------
# 2) BRAIN — ek provider ka key kaafi hai (baaki optional, fallback ban jayenge)
#    Order of preference: gemini → openrouter → groq (auto-detect)
# ---------------------------------------------------------------------------
BRAIN_PROVIDER=                   # auto or a provider; explicit choice is never silently overridden
BRAIN_MODEL=                      # primary brain model; FAST_MODEL/PLANNER_MODEL choose stage models

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # (ye naam bhi chalta hai)

# --- OpenRouter (free `:free` models: https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- optional extra brains ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- role based models (khali chhodo = smart defaults per provider) ---
# BRAIN_MODEL=gemini-3.8-flash
# FAST_MODEL=gemini-3.5-flash-lite
# PLANNER_MODEL=
# CODE_MODEL=
# RESEARCH_MODEL=
# EXTRACT_MODEL=
# VISION_MODEL=
# BROWSER_MODEL=
# CRITIC_MODEL=
# BRAIN_FALLBACKS=gemini-3.7-flash,gemini-2.5-flash
# LLM_TIMEOUT_S=12                # normal model request timeout; fast roles use FAST_LLM_TIMEOUT_S
# FAST_LLM_TIMEOUT_S=7
# LLM_RETRIES=0                   # retries are bounded to avoid long invisible waits
# DSPY_NUM_RETRIES=0
# DSPY_FAST_MAX_TOKENS=500
# DSPY_BRAIN_MAX_TOKENS=900
# MODEL_DISCOVERY=true            # live /models se free model dhoondho
# MODEL_DISCOVERY_TTL_H=12

# ---------------------------------------------------------------------------
# 3) VOICE (LiveKit + Gemini Live)  →  cloud.livekit.io → project → Settings → Keys
# ---------------------------------------------------------------------------
LIVEKIT_URL=                      # wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_ENABLED=true
VOICE_NAME=Charon                 # LiveKit voice
REALTIME_MODEL=gemini-3.8-live    # voice ka dimaag

# ---------------------------------------------------------------------------
# 4) TELEGRAM  →  @BotFather se token, @userinfobot se apna numeric id
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_ALLOWED_CHAT_IDS=        # comma separated (family/team ke liye)
TELEGRAM_ALLOWED_USERS=           # comma separated user ids (guest = read-only tools)

# ---------------------------------------------------------------------------
# 5) SEARCH / WEATHER  (sab optional — ddgs keyless by default ON hai)
# ---------------------------------------------------------------------------
DUCKDUCKGO_ENABLED=true           # keyless multi-engine search (default)
BING_SEARCH_API_KEY=
SEARX_URL=                        # apna SearXNG (private search)
BRAVE_API_KEY=
GOOGLE_SEARCH_API_KEY=
SEARCH_ENGINE_ID=
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# 6) RUNTIME
# ---------------------------------------------------------------------------
WORKSPACE_DIR=                    # khali = ./workspace
APP_MEMORY_FILE=                  # khali = WORKSPACE_DIR/app_launcher_memory.json
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
MAX_ITERATIONS=3                  # graph refine loops
SHOW_REASONING=true               # PLAN/DECISION/ACTION summary dikhao

# feature switches
BROWSER_ENABLED=true
SHELL_ENABLED=true
DESKTOP_ENABLED=true
DESKTOP_MOUSE_ENABLED=true      # mouse input tools on by default; 0 disables pointer actions
DESKTOP_KEYBOARD_ENABLED=true   # keyboard input tools on by default; 0 disables typing/hotkeys
FILE_TOOLS_ENABLED=true
RESEARCH_ENABLED=true
MEMORY_ENABLED=true
AUTOMATION_ENABLED=true

# ---------------------------------------------------------------------------
# 7) SAFETY / PERMISSIONS
# ---------------------------------------------------------------------------
JARVIS_EXEC_APPROVAL=risky       # off | risky | all; risky destructive ops need owner approval
ALLOW_SHELL=true
ALLOW_FILE_DELETE=true
MAX_PROCESSES=12
SHELL_TIMEOUT_S=120
CODE_TIMEOUT_S=90
NIKHILAI_ALLOW_RESTART=1          # /restart command allow hai?

# Secrets placeholders (LLM ko kabhi plain nahi dikhte):
# JARVIS_SECRET_email=you@example.com
# JARVIS_SECRET_password=...

# ---------------------------------------------------------------------------
# 8) BROWSER-USE
# ---------------------------------------------------------------------------
BROWSER_MODE=auto                 # auto | python | cli | cloud
BROWSER_HEADLESS=true
BROWSER_MAX_STEPS=60
BROWSER_TIMEOUT_S=420
BROWSER_MAX_PARALLEL=3
# BROWSER_PROFILE_DIR=            # apna Chrome profile (login wali sites)

# ---------------------------------------------------------------------------
# 9) FILE SEARCH / READING
# ---------------------------------------------------------------------------
FILE_SEARCH_ROOTS=                # khali = home dir | e.g. /home/you/Documents,/home/you/Downloads
MAX_FILE_READ_CHARS=20000
FILE_SEARCH_MAX_RESULTS=15
CONTENT_SEARCH_MAX_FILES=2000

# ---------------------------------------------------------------------------
# 10) API SERVER + DSPy
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1               # local-only default; use 0.0.0.0 only with a strong token
API_PORT=8000
# NIKHILAI_API_TOKEN=            # optional bearer/cookie token; non-loopback without it prints a warning
USE_DSPY=true
DSPY_OPTIMIZED=true
# OFFLINE_MODE=1                  # 1 = keys hone par bhi demo brain (testing ke liye)
